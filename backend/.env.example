# Postgres connection string (Supabase/Neon), asyncpg driver.
# Supabase: use the "connection pooling" URI from Project Settings > Database,
# then swap the postgresql:// prefix for postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Same Google OAuth Client ID configured in the frontend's .env.local
# (GOOGLE_CLIENT_ID) — used only to verify token audience, never a secret.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Any long random string. Generate with: openssl rand -hex 32
BACKEND_JWT_SECRET=change-me

# Any long random string, shared only with your cron trigger config.
INTERNAL_SCHEDULER_SECRET=change-me

# In-process price/FX refresh loop. Leave true for a long-running host
# (local dev, Render). Set false where an external cron drives the refresh
# via POST /internal/refresh (Cloud Run — see docs/cloud-run-migration.md).
# SCHEDULER_ENABLED=true
# SCHEDULER_INTERVAL_HOURS=5
# When SCHEDULER_ENABLED is false, /home and /catalog trigger a best-effort
# catch-up refresh if cached prices are older than this (insurance for a
# missed external cron run). Must exceed the normal gap between scheduled
# runs (prod cron is every 3h → 10h ≈ 3 missed runs).
# REFRESH_STALENESS_THRESHOLD_HOURS=10

CORS_ORIGINS=http://localhost:3000

DEFAULT_BASE_CURRENCY=USD

# Enables POST /internal/dev-reset (wipes the caller's own family back to
# a fresh, un-onboarded state — for local testing only). Leave unset/false
# anywhere this might be reachable by anyone but you.
DEV_MODE=true
